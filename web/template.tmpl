<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: #000;
        color: #fff;
        font-family: "Courier New", Courier, monospace;
        overflow: hidden;
    }

    /* Game canvas fills the entire viewport, loaded in the background */
    canvas.emscripten {
        position: fixed;
        inset: 0;
        width: 100% !important;
        height: 100% !important;
        display: block;
    }

    /* Startup overlay sits on top of the canvas */
    #overlay {
        position: fixed;
        inset: 0;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        padding: 2rem;
        background: #000;
        transition: opacity 0.3s ease;
    }

    #overlay.fade-out {
        opacity: 0;
        pointer-events: none;
    }

    .title {
        font-size: clamp(3rem, 10vw, 6rem);
        font-weight: bold;
        letter-spacing: 0.2em;
        text-align: center;
    }

    .divider {
        width: min(400px, 80vw);
        border: none;
        border-top: 2px solid #fff;
    }

    .controls {
        width: min(400px, 80vw);
        text-align: center;
    }

    .controls h2 {
        font-size: 0.9rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        margin-bottom: 1rem;
        opacity: 0.7;
    }

    .controls table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.85rem;
    }

    .controls th,
    .controls td {
        padding: 0.35rem 0.75rem;
        text-align: center;
    }

    .controls th {
        opacity: 0.6;
        font-weight: normal;
        border-bottom: 1px solid rgba(255,255,255,0.3);
    }

    #play-btn {
        margin-top: 0.5rem;
        padding: 1rem 3rem;
        background: #fff;
        color: #000;
        border: none;
        font-family: inherit;
        font-size: 1.2rem;
        font-weight: bold;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.15s, color 0.15s, transform 0.1s;
    }

    #play-btn:hover { background: #ddd; }
    #play-btn:active { transform: scale(0.97); }

    .hint {
        font-size: 0.75rem;
        opacity: 0.45;
        letter-spacing: 0.1em;
    }

    /* Loading status shown inside the overlay */
    #infobox {
        font-size: 0.7rem;
        opacity: 0.4;
        letter-spacing: 0.08em;
        font-family: "Courier New", Courier, monospace;
        text-align: center;
    }

    /* Hide pygbag debug/transfer elements */
    #transfer, #pyconsole, #crt { display: none !important; }
</style>

